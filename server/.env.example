DATABASE_URL=postgres://arran:arran_dev@localhost:5432/arrandnd
JWT_SECRET=change-me-in-production-min-32-chars

AI_PROVIDER=gemini

# Gemini (default provider)
GEMINI_API_KEY=AIza...
# Optional: override default model
GEMINI_MODEL=gemini-3.8-flash

# Anthropic (optional, used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: override Anthropic model
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3566

# URL publique du serveur, telle que le joueur la saisit dans son connecteur MCP.
# Sert d'issuer OAuth et d'audience des jetons : l'orthographe doit être exacte
# (pas de slash final). En prod : https://arran-dnd.fly.dev
PUBLIC_URL=http://localhost:3566
