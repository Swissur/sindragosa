# À copier en `.env` à côté de docker-compose.nas.yml sur le NAS (plan 36).
# Docker Compose le lit tout seul. Ne jamais le committer.

# Mot de passe de la base : long et aléatoire, il ne se tape jamais à la main.
POSTGRES_PASSWORD=

# Signe les sessions : 32 caractères aléatoires minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Adresse publique donnée par Tailscale Funnel, sans / final.
CLIENT_URL=https://ds220.exemple.ts.net
